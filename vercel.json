{
  "services": {
    "slm-avr-api": {
      "root": ".",
      "buildCommand": "pip install --upgrade pip && pip install -e .",
      "entrypoint": "api/index.py"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "slm-avr-api"
      }
    }
  ]
}
